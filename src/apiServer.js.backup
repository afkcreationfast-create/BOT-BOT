const http = require('http');
const fs = require('fs');
const path = require('path');

let broadcastEvent = () => {};

function json(res, status, data) {
    res.writeHead(status, {
        'Content-Type': 'application/json; charset=utf-8',
        'Cache-Control': 'no-store'
    });
    res.end(JSON.stringify(data));
}

function parseBody(req) {
    return new Promise((resolve, reject) => {
        let body = '';
        req.on('data', chunk => {
            body += chunk;
            if (body.length > 1024 * 1024) {
                req.destroy();
                reject(new Error('Payload trop volumineux.'));
            }
        });
        req.on('end', () => {
            if (!body) return resolve({});
            try {
                resolve(JSON.parse(body));
            } catch {
                reject(new Error('JSON invalide.'));
            }
        });
        req.on('error', reject);
    });
}

function safeEqual(a, b) {
    if (!a || !b || a.length !== b.length) return false;
    let result = 0;
    for (let i = 0; i < a.length; i++) {
        result |= a.charCodeAt(i) ^ b.charCodeAt(i);
    }
    return result === 0;
}

function startApiServer({
    port = 3000,
    host = '127.0.0.1',
    apiKey = '',
    getSessions,
    createSession,
    sendMessage,
    logoutSession
}) {
    const publicDir = path.join(__dirname, '..', 'public');
    const clients = new Set();

    broadcastEvent = (type, data) => {
        const payload = `event: ${type}\ndata: ${JSON.stringify(data)}\n\n`;
        for (const res of clients) {
            try {
                res.write(payload);
            } catch {
                clients.delete(res);
            }
        }
    };

    const server = http.createServer(async (req, res) => {
        const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);

        if (url.pathname === '/events') {
            if (apiKey && !safeEqual(
                req.headers.authorization?.replace(/^Bearer\s+/i, ''),
                apiKey
            )) {
                return json(res, 401, { error: 'Non autorisé.' });
            }

            res.writeHead(200, {
                'Content-Type': 'text/event-stream; charset=utf-8',
                'Cache-Control': 'no-cache, no-store',
                'Connection': 'keep-alive',
                'Access-Control-Allow-Origin': '*'
            });
            res.write(': connected\n\n');
            clients.add(res);
            req.on('close', () => clients.delete(res));
            return;
        }

        if (url.pathname.startsWith('/api/')) {
            const auth = req.headers.authorization?.replace(/^Bearer\s+/i, '');
            if (apiKey && !safeEqual(auth, apiKey)) {
                return json(res, 401, { error: 'Non autorisé.' });
            }

            try {
                if (req.method === 'GET' && url.pathname === '/api/health') {
                    return json(res, 200, {
                        ok: true,
                        name: 'BOT-BOT',
                        uptime: process.uptime(),
                        time: new Date().toISOString()
                    });
                }

                if (req.method === 'GET' && url.pathname === '/api/sessions') {
                    return json(res, 200, { sessions: getSessions() });
                }

                if (req.method === 'POST' && url.pathname === '/api/sessions') {
                    const body = await parseBody(req);
                    const phoneNumber = String(body.phoneNumber || '').replace(/\D/g, '');

                    if (!phoneNumber) {
                        return json(res, 400, { error: 'Numéro WhatsApp requis.' });
                    }

                    const sessionId = `session_${phoneNumber}`;
                    await createSession(sessionId, phoneNumber);
                    return json(res, 201, {
                        ok: true,
                        session: getSessions().find(s => s.sessionId === sessionId)
                    });
                }

                const sessionMatch = url.pathname.match(/^\/api\/sessions\/([^/]+)$/);
                if (sessionMatch) {
                    const sessionId = decodeURIComponent(sessionMatch[1]);

                    if (req.method === 'DELETE') {
                        await logoutSession(sessionId);
                        return json(res, 200, { ok: true });
                    }
                }

                const sendMatch = url.pathname.match(/^\/api\/sessions\/([^/]+)\/send$/);
                if (sendMatch && req.method === 'POST') {
                    const sessionId = decodeURIComponent(sendMatch[1]);
                    const body = await parseBody(req);

                    if (!body.to || !body.text) {
                        return json(res, 400, {
                            error: 'Les champs "to" et "text" sont requis.'
                        });
                    }

                    await sendMessage(sessionId, body.to, body.text);
                    return json(res, 200, { ok: true });
                }

                return json(res, 404, { error: 'Route API introuvable.' });
            } catch (error) {
                console.error('[API]', error);
                return json(res, 500, { error: error.message || 'Erreur serveur.' });
            }
        }

        let filePath = url.pathname === '/'
            ? path.join(publicDir, 'index.html')
            : path.join(publicDir, url.pathname.replace(/^\/+/, ''));

        if (!filePath.startsWith(publicDir)) {
            return json(res, 403, { error: 'Accès refusé.' });
        }

        if (!fs.existsSync(filePath) || fs.statSync(filePath).isDirectory()) {
            filePath = path.join(publicDir, 'index.html');
        }

        const ext = path.extname(filePath);
        const types = {
            '.html': 'text/html; charset=utf-8',
            '.js': 'text/javascript; charset=utf-8',
            '.css': 'text/css; charset=utf-8',
            '.json': 'application/json; charset=utf-8',
            '.svg': 'image/svg+xml'
        };

        res.writeHead(200, {
            'Content-Type': types[ext] || 'application/octet-stream',
            'Cache-Control': ext === '.html' ? 'no-store' : 'public, max-age=3600'
        });
        fs.createReadStream(filePath).pipe(res);
    });

    server.listen(port, host, () => {
        console.log(`[API] http://${host}:${port}`);
    });

    return server;
}

function broadcast(type, data) {
    broadcastEvent(type, data);
}

module.exports = {
    startApiServer,
    broadcast
};
